# Local website configuration. Copy to .env, chmod 600 .env, fill required values,
# then load it with: set -a; . ./.env; set +a
# The binary does not load .env automatically. Never commit the filled file.
# Inference keys do NOT go here: use private near-ai.key / venice.key files on the
# relay machine, referenced by patchriot-relay/agent-settings.example.json.

# REQUIRED: PostgreSQL 17 connection for CORE ONLY, including your database credentials.
# Example shape: postgresql://USER:PASSWORD@127.0.0.1:5432/patchriot_core
DATABASE_URL=
# REQUIRED: generate with openssl rand -hex 32. Use the SAME value in dispatcher.
# This secret authorizes internal service calls; never give it to agents or browsers.
PATCHRIOT_INTERNAL_KEY=
# REQUIRED: exact browser origin, without a path or trailing slash. HTTPS outside localhost.
PATCHRIOT_PUBLIC_ORIGIN=http://127.0.0.1:7410
# REQUIRED: dispatcher's PRIVATE internal listener, reachable from core.
PATCHRIOT_DISPATCHER_URL=http://127.0.0.1:7411
# Browser assets produced by cd web && npm ci --ignore-scripts && npm run build.
PATCHRIOT_WEB_ROOT=web/dist
# Listener; defaults to loopback. Use 0.0.0.0 only behind your configured ingress.
PATCHRIOT_CORE_BIND=127.0.0.1:7410
# Agent-facing URL displayed during pairing; must be reachable from the relay machine.
# For remote agents use the separate HTTPS gateway, never the internal listener.
PATCHRIOT_RELAY_ORIGIN=http://127.0.0.1:7411
# closed (default), coupons, paid, or explicit free pilot. Start closed, configure agents,
# then use coupons for local end-to-end work. Coupons still spend your inference allowance.
PATCHRIOT_REVIEW_MODE=closed
# peer ignores forwarding headers. trusted_x_real_ip requires an ingress that REPLACES
# X-Real-IP on EVERY route to core and prevents direct access to the listener.
PATCHRIOT_CLIENT_IP_SOURCE=peer

# Optional Google sign-in: set BOTH values from your own OAuth application.
# Authorized redirect: PATCHRIOT_PUBLIC_ORIGIN/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Optional GitHub sign-in: set BOTH values from your own OAuth application.
# Callback: PATCHRIOT_PUBLIC_ORIGIN/api/auth/github/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Optional public Reown project ID for WalletConnect. Restrict it to your website origins.
# WC_REOWNED_PRJ_ID=
# Optional public contact address; omit until you have one.
# PATCHRIOT_CONTACT_EMAIL=

# Optional standard Google Analytics on public pages and workspace categories (uses cookies).
# Set true with your own GA4 measurement ID. No secret, proxy hostname or popup is needed.
# Keep Enhanced measurement OFF in the GA web stream so form/URL details are not collected.
PATCHRIOT_ANALYTICS_ENABLED=false
# PATCHRIOT_GA_MEASUREMENT_ID=G-YOURPROJECT
# Legacy only: reserves a former analytics hostname; it serves no app or account routes.
# PATCHRIOT_ANALYTICS_ORIGIN=https://analytics.example.com

# Paid checkout only: your server-side NEAR Intents 1Click key. Also required by payments-run.
# PATCHRIOT_1CLICK_API_KEY=
# Private checkout JSON: destination asset, recipient and accepted inputs. See README.
# Review the exact catalogue IDs and treasury before setting REVIEW_MODE=paid.
# Set either the file OR inline JSON, never both. Existing orders keep their saved terms.
# PATCHRIOT_CHECKOUT_CONFIG=/absolute/private/checkout.json
# PATCHRIOT_CHECKOUT_JSON='{"replace":"with your reviewed checkout policy"}'

# Operator withdrawals are optional and disabled when unset. No payout signer belongs
# in the website, reconciliation worker, dispatcher, agents or browser.
# PATCHRIOT_TREASURY_CONFIG=/absolute/private/treasury.json
# ONLY for a separate payouts-once process, never the web service:
# PATCHRIOT_TREASURY_KEY_FILE=/absolute/private/treasury.key

# Tests only: a dedicated local PostgreSQL database. Never point this at production.
# PATCHRIOT_TEST_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/patchriot_tests

# Private signed-in workspace counts; admin-only, no Google cookies or page URLs.
PATCHRIOT_WORKSPACE_COUNTS_ENABLED=false
